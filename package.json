{
  "name": "kunlunengine-core",
  "version": "0.1.0",
  "private": true,
  "description": "A bundler-neutral TypeScript application platform from Zixiao Laboratories",
  "license": "MIT",
  "author": "Zixiao Laboratories",
  "homepage": "https://github.com/kunlunengine/core#readme",
  "repository": "github:kunlunengine/core",
  "bugs": "https://github.com/kunlunengine/core/issues",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false",
    "clean": "tsc -b --clean",
    "release:publish": "node scripts/publish-release.mjs",
    "release:dry-run": "node scripts/publish-release.mjs --dry-run",
    "authority:node": "node scripts/collect-node-authority.mjs",
    "test": "lightning run",
    "test:watch": "lightning watch",
    "test:packages": "pnpm build && node scripts/test-packed-test-utils.mjs",
    "test:cli:packages": "pnpm build && node scripts/test-packed-cli.mjs"
  },
  "devDependencies": {
    "@lightning-js/lightning": "3.1.0",
    "@nasti-toolchain/nasti": "2.5.2",
    "@rspack/core": "2.1.10",
    "@rspack/dev-middleware": "2.0.3",
    "@types/node": "^24.19.1",
    "typescript": "^5.9.3",
    "undici": "^7.30.0",
    "vite": "^8.3.2",
    "webpack": "^5.111.1",
    "webpack-dev-middleware": "^8.3.0"
  }
}
